// =============================================================================
// secretariat.casl — the CHOREOGRAPHY SEAM (human-read, `casl check`-verified)
// =============================================================================
// This is the part a human reads: who may do what, in what order, with which
// effect, gated by whom. The artifact BODIES (artifacts/*.py) hang off the
// capabilities + oracle steps named here; see ../casl.toml + ../requirements.
//
// U = User, S = secretary (agent), K = calendar, M = mail.
//   casl check examples/projects/secretariat/casl/secretariat.casl   # ✓ accepted
// =============================================================================
protocol Secretariat {
  roles U, S, K, M;
  agent S caps {
    calendar(event) scope "cal:write"  mode write ttl 1 sig "s1";
    mail(to)        scope "mail:send"  mode write ttl 1 sig "s2";
  }

  // S proposes a slot the `conflict_check` (verified, LH-LOCAL-002) predicate
  // admits — the [conflicts <= 0] contract is that property at the seam.
  U -> S : Conflict(detail: Str);
  S -> U : Proposal(slot: Int, conflicts: Int) [conflicts <= 0];

  // The irreversible calendar move + the mail send live in the CONSENT branch of
  // an approval gate (LH-Q-011). `draft_reply` (LH-LOCAL-003) produces the body.
  choice approval at U -> S {
    Approve consent: {
      S -> K : Move() uses calendar irreversible;
      S -> M : Notify() uses mail;
      M -> U : Done();
    }
    Deny: {
      S -> K : Keep();
      S -> M : Hold();
      M -> U : Done();
    }
  }
}
