// =============================================================================
// secretariat.casl — FOUR roles (target-picture slice, VISION §6)
// =============================================================================
// U = User, S = secretary (agent/oracle), K = calendar, M = mail.
// Shows that CASL is expressible beyond the 3-role head fragment:
// projection/merge/realizability are parametric over the role set.
//
// Safety applies as before: the irreversible rescheduling (Move, uses calendar)
// and the mail send (Notify, uses mail) lie in the consent branch of an
// approval gate (LH-Q-011). Realizable: in BOTH branches the
// bystanders K and M each receive a distinguishing message from S (mergeable).
//
//   ./casl check examples/secretariat.casl          # ✓ accepted (4 roles)
//   ./casl run   examples/secretariat.casl --approve # consent branch runs
// =============================================================================
protocol Secretariat {
  roles U, S, K, M;
  agent S caps {
    calendar(event) scope "cal:write" mode write ttl 1 sig "s1";
    mail(to) scope "mail:send" mode write ttl 1 sig "s2";
  }

  U -> S : Conflict(detail: Str);
  choice approval at U -> S {
    Approve consent: {
      S -> K : Move() uses calendar irreversible;
      S -> M : Notify() uses mail;
      M -> U : Done();
    }
    Deny: {
      S -> K : Keep();
      S -> M : Hold();
      M -> U : Done();
    }
  }
}
