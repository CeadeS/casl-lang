// ATTACK C2 (Red-Team v0.1.27): effect-bearing capability (mail:send), untagged and
// without any approval. `casl check` MUST reject (effect bound to capability,
// deny-by-default: non-readonly ⇒ irreversible).
protocol SilentSend {
  roles S, U, M;
  agent S caps { mail(to) scope "mail:send" ttl 1 sig "s1"; }
  S -> U : Notice(detail: Str);
  S -> M : SendEmail() uses mail;
}
