// Termination-annotated variant — parses exactly to casl_core.G_OK_TERM
// (ranking measure budget with upper bound 3 → loop terminates, ttl-safe).
protocol BudgetedQA {
  roles C, A, J;
  agent A caps { search(query) scope "web:readonly" mode read ttl 3 sig "sig-A1"; }
  crash A;

  C -> A : Request(question: Str, budget: Int);
  rec Loop measure budget bound 3 {
    A -> J : Draft(answer: Str, cost: Int) [cost <= budget] uses search oracle;
    choice at J -> C {
      Accept: { J -> A : Done(); }
      Reject(reason: Str) [len(reason) > 0]: { J -> A : Retry(); continue Loop; }
    }
  }
}
