// =============================================================================
// email_secretary_reply.casl — the FOUR-BUTTON reply flow (case study)
// See docs/cookbook/email-secretary.md
// =============================================================================
// U = User, S = secretary agent (LLM-backed), M = mail connector.
//
// S summarizes the incoming mail (monitored `oracle` boundary, bounded by [len <= cap]).
// Then U presses ONE of four buttons (a `choice at U -> S`):
//   Reject  — no reply, just file the mail away.
//   Accept  — LLM drafts an acceptance; the SEND is irreversible → approval gate.
//   Analyze — LLM analyzes the work, measures it against standards, drafts a SHORT
//             reply; the SEND is irreversible → approval gate.
//   Direct  — LLM drafts a direct reply; the SEND is irreversible → approval gate.
//
// Safety: every effect-bearing SEND (uses send, mode write) is irreversible and
// sits in the `consent` branch of an approval gate (LH-Q-011). M (mail connector)
// receives a distinguishing label on every path (FileAway / Deliver / Keep) → realizable.
//
//   ./casl check examples/email_secretary_reply.casl
//   ./casl run   examples/email_secretary_reply.casl --approve
// =============================================================================
protocol EmailSecretaryReply {
  roles U, S, M;
  agent S caps {
    inspect(mail)   scope "mail:readonly" mode read  ttl 1 sig "s0";
    compose(prompt) scope "llm:compose"   mode read  ttl 1 sig "s1";
    send(to)        scope "mail:send"     mode write ttl 1 sig "s2";
  }

  M -> S : Arrived(subject: Str, cap: Int);
  S -> U : Brief(summary: Str, size: Int) [size <= cap] uses inspect oracle;
  choice at U -> S {
    Reject: {
      S -> M : FileAway();
    }
    Accept: {
      S -> U : Draft(text: Str, size: Int) [size <= cap] uses compose;
      choice approval at U -> S {
        Send consent: { S -> M : Deliver() uses send irreversible; }
        Hold:         { S -> M : Keep(); }
      }
    }
    Analyze: {
      S -> U : Short(text: Str, size: Int) [size <= cap] uses compose;
      choice approval at U -> S {
        Send consent: { S -> M : Deliver() uses send irreversible; }
        Hold:         { S -> M : Keep(); }
      }
    }
    Direct: {
      S -> U : Reply(text: Str, size: Int) [size <= cap] uses compose;
      choice approval at U -> S {
        Send consent: { S -> M : Deliver() uses send irreversible; }
        Hold:         { S -> M : Keep(); }
      }
    }
  }
}
